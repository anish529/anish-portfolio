# Anish Kumar Prajapati — Portfolio Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to Git.

# Google Tag Manager ID (optional — leave blank if not using GTM)
NEXT_PUBLIC_GTM=

# Full public URL of your deployed site, e.g. https://anishprajapati.dev
# Used for canonical URLs and Open Graph metadata
NEXT_PUBLIC_SITE_URL=

# Your app's base URL (used by the contact form to call the API)
# In development: http://localhost:3000
# In production: your actual domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Contact Form (Email via Gmail + Telegram notification) ---
# Gmail address that will receive contact form submissions
EMAIL_ADDRESS=prajapatianish437@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_PASSKEY=

# Telegram bot token for real-time contact notifications (optional)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Telegram chat ID to receive notifications (optional)
# Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# --- Social Profiles (configure once verified) ---
# Set your real GitHub profile URL to display the GitHub icon
NEXT_PUBLIC_GITHUB_URL=https://github.com/anish529

# Set your real LinkedIn profile URL to display the LinkedIn icon
NEXT_PUBLIC_LINKEDIN_URL=www.linkedin.com/in/anish-kumar-prajapati-9983a3336


